# ─── Database (required) ─────────────────────────────────────────────────────
# Local PostgreSQL: postgres://username:password@localhost:5432/pulserpm
# Remote (e.g. Supabase, Neon, Railway): paste the connection string they give you
DATABASE_URL=postgres://postgres:password@localhost:5432/pulserpm

# ─── Auth secrets (required) ─────────────────────────────────────────────────
# Any long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string
SCHEDULER_JWT_SECRET=change-me-to-yet-another-long-random-string

# ─── Email (optional — app works without it; verification codes log to console) ─
# Option A: Gmail App Password (Settings → Security → 2-Step → App passwords)
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Option B: Resend (https://resend.com — free tier available)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Optional / advanced ─────────────────────────────────────────────────────
# Add extra allowed CORS origins (comma-separated) — only needed if you serve
# the dashboard from a different port/domain than the API
# EXTRA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis for multi-instance SSE broadcast — not needed for a single local instance
# REDIS_URL=redis://localhost:6379
